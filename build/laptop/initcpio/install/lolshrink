#!/bin/bash
# mkinitcpio hook for build/laptop/shrink.sh (mkinitcpio -D build/laptop/initcpio).

build() {
    local dir
    dir=$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")
    add_binary e2fsck
    add_binary resize2fs
    add_binary sfdisk
    add_file "$dir/lolshrink.sh" /usr/local/bin/lolshrink 755
    add_file "$dir/lolshrink.service" /usr/lib/systemd/system/lolshrink.service
    add_symlink /usr/lib/systemd/system/initrd.target.wants/lolshrink.service /usr/lib/systemd/system/lolshrink.service
}

help() {
    echo 'Shrinks the root ext4 and its partition before it is mounted: lolssd.shrink=<part>:<sectors>.'
}
