#!/bin/sh
# lolssd: мастер установки из исходников — собирает dist/lolssd-setup (нужен Go) и запускает его.
# Готовый бинарник лежит в релизах на GitHub: его можно запускать и без Go.
set -e
cd "$(dirname "$0")/.."
command -v go >/dev/null || { echo "нужен Go: sudo pacman -S go (или готовый lolssd-setup из релиза)" >&2; exit 1; }
make -s setup
exec dist/lolssd-setup
