 #define TIMESPEC_NSEC_PER_SEC 1000000000LL
 
+// lolssd: a DRM device for headless rendering where no display device exists (WSL: vgem).
+// AQ_HEADLESS_DRM_DEVICE names it; buffers are allocated on it and EGL is opened on it, mode
+// setting is never used. File-scope rather than a member, so the library stays ABI-compatible
+// with the distro's build and can be swapped in under the same Hyprland.
+static int g_headlessDevice = -1;
+
+// lolssd: size of the n-th headless output: AQ_HEADLESS_MODES="WxH,WxH,..." (one per monitor
+// the session shows; the last one repeats), else AQ_HEADLESS_MODE="WxH", else 1920x1080.
+static Vector2D headlessModeFor(size_t n) {
+    const char* list = getenv("AQ_HEADLESS_MODES");
+    if (!list || !*list)
+        list = getenv("AQ_HEADLESS_MODE");
+    Vector2D size = {1920, 1080};
+    if (!list)
+        return size;
+    std::string s = list;
+    size_t      i = 0, start = 0;
+    while (true) {
+        size_t      end  = s.find(',', start);
+        std::string item = s.substr(start, end == std::string::npos ? std::string::npos : end - start);
+        int         w = 0, h = 0;
+        if (sscanf(item.c_str(), "%dx%d", &w, &h) == 2 && w > 0 && h > 0)
+            size = {(double)w, (double)h};
+        if (i == n || end == std::string::npos)
+            return size;
+        start = end + 1;
+        i++;
+    }
+}
