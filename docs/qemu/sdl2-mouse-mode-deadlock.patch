+/*
+ * Mouse mode notifiers run in whichever thread changed the input handlers,
+ * often a vCPU thread with the BQL held (the guest enabling its tablet).
+ * On Windows, SDL window calls from a thread other than the one that created
+ * the window (the grab and the title update here) become a synchronous
+ * SendMessage to that thread, the main loop, which may be waiting for the
+ * BQL: a deadlock that stops the guest. Do the work in the main loop.
+ */
+static void sdl_mouse_mode_change(Notifier *notify, void *data)
+{
+    aio_bh_schedule_oneshot(qemu_get_aio_context(), sdl_mouse_mode_change_bh,
+                            NULL);
+}
